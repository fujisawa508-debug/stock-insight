# Supabase接続情報のひな形。
# このファイルをコピーして .env.local を作成し、実際の値を設定してください。
# .env.local は .gitignore 対象のため Git にはコミットされません。
#
# 値は Supabase ダッシュボード > Project Settings > API から取得できます。
# - SUPABASE_URL: Project URL
# - SUPABASE_ANON_KEY: anon public key
#
# service_role key はここには設定しません（ブラウザ/サーバーを問わず
# このアプリでは今回使用しません）。

SUPABASE_URL=
SUPABASE_ANON_KEY=

# J-Quants API V2（https://api.jquants.com）のAPIキー。
# ダッシュボードの [API Keys] 画面から発行する（V1のようなメールアドレス/
# パスワードでのトークン取得は不要）。
JQUANTS_API_KEY=
